# Runtime credentials used by Airflow, DBT, and the ingestion script.
# Authentication is via an RSA key pair.
# Copy this file to .env and fill in your values.

SNOWFLAKE_ACCOUNT=YTQEMJI-TW17096
SNOWFLAKE_USER=DWS_SERVICE_USER
SNOWFLAKE_ROLE=DWS_SERVICE_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_PRIVATE_KEY_PATH=/opt/airflow/secrets/rsa_key.p8

# Optional: where generated trade files are written
TRADE_DATA_DIR=data/raw

# SMTP config used by Airflow for failure alerting (email_on_failure)
AIRFLOW_SMTP_HOST=smtp.gmail.com
AIRFLOW_SMTP_PORT=587
AIRFLOW_SMTP_USER=your_email@gmail.com
AIRFLOW_SMTP_PASSWORD=your_16_char_app_password
AIRFLOW_SMTP_MAIL_FROM=your_email@gmail.com
ALERT_EMAIL_TO=recipient@example.com

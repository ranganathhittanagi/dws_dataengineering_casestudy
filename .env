# Non-sensitive runtime settings used by Airflow and DBT.
# The RSA key pair is NOT here - it lives in AWS SSM Parameter Store under
# SNOWFLAKE_PARAM_PATH and is fetched at runtime.
# Never commit .env or key files to version control.

SNOWFLAKE_ACCOUNT=YTQEMJI-TW17096
SNOWFLAKE_USER=DWS_SERVICE_USER
SNOWFLAKE_ROLE=DWS_SERVICE_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# AWS: S3 source and SSM Parameter Store holding the Snowflake key pair
AWS_REGION=ap-south-1
AWS_PROFILE=dws-pipeline
S3_BUCKET=trades-source-dws
S3_PREFIX=raw/trades
SNOWFLAKE_PARAM_PATH=/dws/snowflake/dws-service-user

# SMTP config used by Airflow for failure alerting (email_on_failure)
AIRFLOW_SMTP_HOST=smtp.gmail.com
AIRFLOW_SMTP_PORT=587
AIRFLOW_SMTP_USER=ranganath031@gmail.com
AIRFLOW_SMTP_PASSWORD=dthlenxfqdmtwmtw
AIRFLOW_SMTP_MAIL_FROM=ranganath031@gmail.com
ALERT_EMAIL_TO=ranganath.hittanagi@gmail.com

# Admin credentials for Terraform go in terraform/terraform.tfvars (not here).